  
; ---------------------------------------------------------------------------
; REFERENCE ReShade.ini - for the GAME's runtime.
;
; THIS IS A REFERENCE, NOT A FILE TO DROP IN. If you already have a working
; ReShade setup, do not overwrite it. Compare it against this one and copy the
; handful of keys that matter, which are marked below.
;
; This is the configuration every published measurement was taken under, with
; the machine-specific and cosmetic parts stripped: no window layout, no cache
; path, no effect preprocessor definitions, and no other add-on's settings.
;
; The bridge's OWN runtime is configured by ReShade2.ini, which ships in the
; download. This file is only the game side.
; ---------------------------------------------------------------------------
 
[ADDON]
DisabledAddons=
 
[GENERAL]
EffectSearchPaths=.\reshade-shaders\Shaders\**
TextureSearchPaths=.\reshade-shaders\Textures\**
NoDebugInfo=1
NoEffectCache=0
NoReloadOnInit=0
PerformanceMode=0
SkipLoadingDisabledEffects=0
; MATTERS. Whatever this points at, know what is enabled in it. Any effect
; enabled for the GAME is drawn before the frame reaches the bridge, so it
; becomes part of what the neural stage sees.
PresetPath=.\ReShadePreset.ini
PresetShortcutKeys=
PresetShortcutPaths=
PresetTransitionDuration=1000
StartupPresetPath=
 
[INPUT]
ForceShortcutModifiers=1
GamepadNavigation=0
InputProcessing=2
KeyEffects=0,0,0,0
KeyFPS=0,0,0,0
KeyFrametime=0,0,0,0
KeyNextPreset=0,0,0,0
; Home opens the overlay, which is where the MGPU Bridge panel lives.
KeyOverlay=36,0,0,0
KeyPreviousPreset=0,0,0,0
KeyReload=0,0,0,0
KeyScreenshot=44,0,0,0
 
[OVERLAY]
; MATTERS. With this at 1, anything you toggle in the overlay is written back
; to the preset when the game closes, so presets drift between runs with nobody
; editing a file and the run you measure is not the run you repeat. This cost
; one invalid measurement run on this project before it was found.
AutoSavePreset=0
; MATTERS for comparing rates. There are two ReShade runtimes in the process,
; so each draws its own counter for its own swapchain - the game's rate and the
; bridge's rate are different numbers and the difference is the point. Set this
; in ReShade2.ini as well.
ShowFPS=1
ClockFormat=0
FPSPosition=1
Language=
ShowClock=0
ShowForceLoadEffectsButton=1
ShowFrameTime=0
ShowPresetName=0
ShowPresetTransitionMessage=1
ShowScreenshotMessage=1
TutorialProgress=2
VariableListHeight=200.000000
VariableListUseTabs=0
 
[PROXY]
EnableProxyLibrary=0
ProxyLibrary=
 
[SCREENSHOT]
; SaveOverlayShot=1 writes a second image WITH the overlay visible alongside
; the clean one - useful when you want the pass count and the split seam in the
; shot. Optional.
SaveOverlayShot=1
ClearAlpha=1
FileFormat=1
FileNaming=%AppName% %Date% %Time%_%Count%
JPEGQuality=90
PostSaveCommand=
PostSaveCommandArguments="%TargetPath%"
PostSaveCommandHideWindow=0
PostSaveCommandWorkingDirectory=.\
SaveBeforeShot=0
SavePath=.\
SavePresetFile=0
SoundPath=
